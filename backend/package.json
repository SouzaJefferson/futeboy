{
  "name": "@futeboy/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/domain.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --import tsx src/config/prisma-cli.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node --import tsx src/config/prisma-cli.ts studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
