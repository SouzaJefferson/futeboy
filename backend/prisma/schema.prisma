generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
}

enum Position {
  GOALKEEPER
  DEFENDER
  FULLBACK
  MIDFIELDER
  FORWARD
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum EventKind {
  GOAL
  YELLOW_CARD
  RED_CARD
  NOTE
}

enum ChampionshipFormat {
  LEAGUE
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(254)
  passwordHash  String
  role          Role           @default(PLAYER)
  photoUrl      String?
  createdAt     DateTime       @default(now())
  sessions      Session[]
  player        Player?
  teams         Team[]
  managedTeams  TeamManager[]
  players       Player[]       @relation("PlayerCreator")
  championships Championship[]
  matches       Match[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(100)
  shortName     String             @db.VarChar(5)
  color         String             @default("#236b49") @db.VarChar(7)
  crestUrl      String?
  description   String             @default("") @db.VarChar(1000)
  city          String             @default("") @db.VarChar(100)
  ownerId       String             @db.Uuid
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  managers      TeamManager[]
  memberships   Membership[]
  championships ChampionshipTeam[]
  homeMatches   Match[]            @relation("HomeTeam")
  awayMatches   Match[]            @relation("AwayTeam")
  events        MatchEvent[]

  @@index([ownerId])
  @@index([name])
}

model TeamManager {
  teamId String @db.Uuid
  userId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Player {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(100)
  nickname     String?      @db.VarChar(50)
  photoUrl     String?
  position     Position
  userId       String?      @unique @db.Uuid
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdById  String       @db.Uuid
  createdBy    User         @relation("PlayerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  @@index([createdById])
  @@index([name])
}

model Membership {
  id          String       @id @default(uuid()) @db.Uuid
  playerId    String       @db.Uuid
  teamId      String       @db.Uuid
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  shirtNumber Int
  isCaptain   Boolean      @default(false)
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  events      MatchEvent[]  @relation("EventPlayer")
  assists     MatchEvent[]  @relation("EventAssistant")

  @@index([teamId, endedAt])
  @@index([playerId, startedAt])
}

model Championship {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(100)
  description String             @default("") @db.VarChar(1000)
  format      ChampionshipFormat @default(LEAGUE)
  startsAt    DateTime
  endsAt      DateTime
  ownerId     String             @db.Uuid
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  teams       ChampionshipTeam[]
  matches     Match[]

  @@index([ownerId])
  @@index([startsAt])
}

model ChampionshipTeam {
  championshipId String       @db.Uuid
  teamId         String       @db.Uuid
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([championshipId, teamId])
  @@index([teamId])
}

model Match {
  id             String        @id @default(uuid()) @db.Uuid
  homeTeamId     String        @db.Uuid
  awayTeamId     String        @db.Uuid
  homeTeam       Team          @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam       Team          @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  championshipId String?       @db.Uuid
  championship   Championship? @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  ownerId        String        @db.Uuid
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  startsAt       DateTime
  location       String        @db.VarChar(200)
  round          Int?
  status         MatchStatus   @default(SCHEDULED)
  createdAt      DateTime      @default(now())
  events         MatchEvent[]

  @@index([startsAt, status])
  @@index([championshipId, status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([ownerId])
}

model MatchEvent {
  id           String     @id @default(uuid()) @db.Uuid
  matchId      String     @db.Uuid
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Restrict)
  teamId       String     @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  kind         EventKind
  minute       Int
  membershipId String?    @db.Uuid
  membership   Membership? @relation("EventPlayer", fields: [membershipId], references: [id], onDelete: Restrict)
  assistantId  String?    @db.Uuid
  assistant    Membership? @relation("EventAssistant", fields: [assistantId], references: [id], onDelete: Restrict)
  note         String?    @db.VarChar(500)
  createdAt    DateTime   @default(now())

  @@index([matchId, minute])
  @@index([membershipId])
  @@index([assistantId])
  @@index([teamId])
}
